// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN    @map("admin")
  EMPLOYEE @map("employee")
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum AppointmentStatus {
  SCHEDULED @map("scheduled")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
}

model Shop {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  appointments   Appointment[]
  staffColorMaps StaffColorMap[]
  auditLogs      AuditLog[]
  systemSetting  SystemSetting?

  @@map("shops")
}

model User {
  id                  String         @id @default(cuid())
  shopId              String         @map("shop_id")
  username            String         @unique
  passwordHash        String         @map("password_hash")
  displayName         String         @map("display_name")
  role                UserRole       @default(EMPLOYEE)
  status              UserStatus     @default(ACTIVE)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")
  shop                Shop           @relation(fields: [shopId], references: [id])
  employeeAppointments Appointment[] @relation("EmployeeAppointments")
  createdAppointments Appointment[]  @relation("AppointmentCreatedBy")
  updatedAppointments Appointment[]  @relation("AppointmentUpdatedBy")
  auditLogs           AuditLog[]     @relation("ActorAuditLogs")
  roleAssignments     UserRoleAssignment[]

  @@index([shopId])
  @@map("users")
}

model StaffColorMap {
  shopId    String   @map("shop_id")
  staffName String   @map("staff_name")
  color     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shop      Shop     @relation(fields: [shopId], references: [id])

  @@id([shopId, staffName])
  @@map("staff_color_map")
}

model Appointment {
  id                   String            @id @default(cuid())
  shopId               String            @map("shop_id")
  employeeId           String            @map("employee_id")
  employeeDisplayName  String?           @map("employee_display_name")
  employeeColor        String?           @map("employee_color")
  startAt              DateTime          @map("start_at")
  endAt                DateTime          @map("end_at")
  phone                String
  price                Int
  customerName         String?           @map("customer_name")
  serviceName          String?           @map("service_name")
  note                 String?
  status               AppointmentStatus @default(SCHEDULED)
  createdById          String            @map("created_by")
  updatedById          String            @map("updated_by")
  groupId              String?           @map("group_id")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  deletedAt            DateTime?         @map("deleted_at")
  shop                 Shop              @relation(fields: [shopId], references: [id])
  employee             User              @relation("EmployeeAppointments", fields: [employeeId], references: [id])
  createdBy            User              @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  updatedBy            User              @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id])

  @@index([employeeId, startAt, endAt])
  @@index([startAt, endAt])
  @@index([groupId])
  @@index([shopId, startAt, endAt])
  @@map("appointments")
}

model AuditLog {
  id           String   @id @default(cuid())
  shopId       String   @map("shop_id")
  actorUserId  String   @map("actor_user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  beforePayload Json?   @map("before_payload")
  afterPayload Json?    @map("after_payload")
  createdAt    DateTime @default(now()) @map("created_at")
  shop         Shop     @relation(fields: [shopId], references: [id])
  actor        User     @relation("ActorAuditLogs", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([shopId])
  @@map("audit_logs")
}

model RbacRole {
  id              String               @id @default(cuid())
  roleKey         String               @unique @map("role_key")
  roleName        String               @map("role_name")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  permissionKey   String           @unique @map("permission_key")
  permissionName  String           @map("permission_name")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  role         RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model SystemSetting {
  shopId              String   @id @map("shop_id")
  calendarWindowStart String?  @map("calendar_window_start")
  calendarWindowEnd   String?  @map("calendar_window_end")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  shop                Shop     @relation(fields: [shopId], references: [id])

  @@map("system_settings")
}
